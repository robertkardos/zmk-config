# This file was generated from a template. Edit it to match your keyboard.
# See https://docs.zephyrproject.org/4.1.0/hardware/porting/board_porting.html#write-kconfig-files
# for more information.

if BOARD_FLAT_2X7X5_LEFT

config ZMK_KEYBOARD_NAME
    default "flat-2x7x5"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_FLAT_2X7X5_LEFT

if BOARD_FLAT_2X7X5_LEFT || BOARD_FLAT_2X7X5_RIGHT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config BT_CTLR
    default BT

endif # BOARD_FLAT_2X7X5_LEFT || BOARD_FLAT_2X7X5_RIGHT
